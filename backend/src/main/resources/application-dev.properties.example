# Copia este archivo como application-dev.properties y rellena con tus valores reales
# NUNCA subas application-dev.properties a Git

spring.datasource.url=jdbc:postgresql://localhost:5432/app_db
spring.datasource.username=TU_USUARIO_DB
spring.datasource.password=TU_CONTRASENA_DB
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# Security JWT
security.jwt.secret.key=TU_CLAVE_JWT_EN_BASE64
security.jwt.expiration.time=86400000
